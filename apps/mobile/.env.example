EXPO_PUBLIC_APP_ENV=LOCAL
# localhost for desktop, 10.0.2.2 for Android Emulator, or your LAN IPv4 for a phone.
EXPO_PUBLIC_DEV_HOST=localhost
# Optional LOCAL URL overrides. PREVIEW only accepts its allowlisted HTTPS API;
# PRODUCTION is reserved and currently refused.
# EXPO_PUBLIC_API_URL=http://localhost:5001/demo-team517/us-central1/api/api/v1
# EXPO_PUBLIC_AUTH_EMULATOR_URL=http://localhost:9199
EXPO_PUBLIC_FIREBASE_API_KEY=demo-key
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-team517
EXPO_PUBLIC_FIREBASE_APP_ID=demo-app
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-team517.firebaseapp.com
# Business Messaging uses the authenticated HTTP API, never client Firestore.
# Native Android push requires a custom native build (LOCAL dev-client or
# standalone PREVIEW); Expo Go is unsupported.
# Build-only environment variable (not EXPO_PUBLIC): external Firebase Android config.
# TEAM517_GOOGLE_SERVICES_FILE=C:/local-private/team517/google-services.json
# PREVIEW is an explicit cloud build, not production. Use preview:android or the
# EAS preview profile; do not copy LOCAL endpoint overrides into that build.
# EXPO_PUBLIC_APP_ENV=PREVIEW
# Cloud API is centrally allowlisted to team517-dev / us-central1.

# Android-only client map configuration, supplied securely at native build time.
# Use an Android package + actual signing SHA-1 + Maps SDK for Android restricted key.
# Optional: unset keeps credential-free LOCAL/CI builds working with List fallback.
TEAM517_ANDROID_MAPS_API_KEY=
