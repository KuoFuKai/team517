# Backend-only. Copy to functions/.env.local for Firebase Functions Emulator.
# Default (unset): disabled. No real provider adapter or secrets are configured.
# mock is accepted only when FUNCTIONS_EMULATOR=true and NODE_ENV != production.
AI_PROVIDER=mock

# Push defaults disabled. CI never sends a real push.
# For explicit native acceptance only, supply external FCM credentials via
# GOOGLE_APPLICATION_CREDENTIALS (outside the repository) and uncomment:
# PUSH_PROVIDER=fcm
# FCM_PROJECT_ID=your-real-test-firebase-project
# PUSH_ALLOW_EMULATOR_FCM=true
